#!/usr/bin/env sh

if git diff --cached --name-only | grep -q "website/content/documentation.mdx"; then
    if ! SCRIPT_OUTPUT=$(npx --no-install tsx scripts/documentation.ts); then
        echo "$SCRIPT_OUTPUT"
        echo "[domet] Documentation sync failed. Commit aborted."
        exit 1
    fi

    UPDATED_FILES=$(echo "$SCRIPT_OUTPUT" | tail -n 1)
    
    if [ -n "$UPDATED_FILES" ] && [ "$UPDATED_FILES" != "○ Syncing Documentation" ]; then
        echo "$UPDATED_FILES" | xargs git add
    fi
fi