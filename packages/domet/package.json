{
  "name": "domet",
  "description": "A React hook for scroll tracking with smooth 60fps performance and smart hysteresis",
  "version": "1.2.1",
  "author": "blksmr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blksmr/domet.git"
  },
  "homepage": "https://domet.blksmr.com",
  "bugs": {
    "url": "https://github.com/blksmr/domet/issues"
  },
  "keywords": [
    "react",
    "scroll",
    "scroll-spy",
    "scrollspy",
    "hooks",
    "navigation",
    "active-section"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.mjs",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.mts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev": "bunchee -w",
    "build": "bunchee",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=verbose",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/es/index.mjs",
      "import": "*",
      "ignore": [
        "./debug-*"
      ],
      "limit": "7 kB"
    },
    {
      "name": "debug panel (loaded on demand)",
      "path": "dist/es/debug-*.mjs",
      "limit": "8 kB"
    }
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "bunchee": "^6.6.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.2",
    "size-limit": "^12.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
